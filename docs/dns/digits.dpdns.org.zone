; DNS for digits.dpdns.org
; Generated by scripts/dns-records.mjs — do not edit by hand.
;
; Import in Cloudflare: DNS -> Records -> Import and Export -> Import.
; Every name is fully qualified, so it is correct whether the zone is
; digits.dpdns.org or its parent.
;
; Set the CNAME below to "DNS only" (grey cloud) until GitHub has issued the
; certificate, otherwise the ACME challenge cannot complete.

; GitHub Pages
digits.dpdns.org.                          1 IN CNAME  yakyakyak14.github.io.

; Resend DKIM
resend._domainkey.digits.dpdns.org.        1 IN TXT    "p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC7zQI2eVFEvtvOmesREv2Eml+e131oj5Far3d7BOAiR2UW3IFskmgOXwzkqESz91W7EbfoyqxGOMsBOQ986t6OWFQAqRo6MYvNLE5J+4tWuz3ntyUCk3BVUZObKjJmxcCN/KUSiZ97bHcgHcOpPl1NYmqgqsM2sz+DDQuQQ4mHAQIDAQAB"

; Resend SPF
send.digits.dpdns.org.                     1 IN MX     10 feedback-smtp.us-east-1.amazonses.com.

; Resend SPF
send.digits.dpdns.org.                     1 IN TXT    "v=spf1 include:amazonses.com ~all"

; Cloudflare Email Routing
digits.dpdns.org.                          1 IN MX     2 route1.mx.cloudflare.net.

; Cloudflare Email Routing
digits.dpdns.org.                          1 IN MX     21 route2.mx.cloudflare.net.

; Cloudflare Email Routing
digits.dpdns.org.                          1 IN MX     31 route3.mx.cloudflare.net.

; Cloudflare Email Routing
digits.dpdns.org.                          1 IN TXT    "v=spf1 include:_spf.mx.cloudflare.net include:amazonses.com ~all"

; DMARC
_dmarc.digits.dpdns.org.                   1 IN TXT    "v=DMARC1; p=none;"
